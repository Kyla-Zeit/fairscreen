{
  "name": "fairscreen",
  "version": "0.11.10",
  "private": true,
  "type": "module",
  "description": "FairScreen static local-first interview practice and private local coaching.",
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "prepare:mediapipe": "node scripts/prepare-mediapipe-assets.mjs",
    "predev": "npm run prepare:mediapipe",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "browser": "npm run build && node scripts/run-browser-smoke.mjs",
    "prebuild": "npm run prepare:mediapipe",
    "build": "vite build",
    "scan:language": "node scripts/check-prohibited-language.mjs",
    "scan:secrets": "node scripts/check-secrets.mjs",
    "audit:deps": "node scripts/audit-dependencies.mjs",
    "audit:build": "node scripts/audit-build-artifacts.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run scan:language && npm run scan:secrets && npm run audit:deps && npm run build && npm run audit:build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "lucide-react": "1.28.0",
    "mammoth": "1.12.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "10.5.4",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "playwright": "1.62.0",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
